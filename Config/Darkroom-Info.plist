<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the keys Xcode generates from the build settings. -->
	<key>DarkroomServer</key>
	<string>$(DARKROOM_SERVER)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Lets a Debug build reach the local test server (http://localhost). -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
